# Configuração do Ambiente (sandbox ou production)
ENVIRONMENT=sandbox

# Credenciais do Mercado Pago
# IMPORTANTE: O Access Token DEVE ficar exclusivamente no backend (.env) e NUNCA no frontend
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu_access_token_aqui
MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua_public_key_aqui

# URL Base do Site (utilizada para retorno de pagamento e webhook)
SITE_URL=http://localhost:3000
